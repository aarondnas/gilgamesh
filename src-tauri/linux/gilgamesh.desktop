# Tauri's desktop entry plus "Open with" for .tex files (tauri.linux.conf.json): %F passes the
# files to the app, which opens their project (src-tauri/src/window/mod.rs, start_from_args);
# MimeType offers it for LaTeX without making it the default, which stays in mimeapps.list.
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
MimeType=text/x-tex;
