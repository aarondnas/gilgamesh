{
  "name": "gilgamesh",
  "private": true,
  "version": "0.1.0",
  "description": "LaTeX editor with a live PDF preview",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "node scripts/paraglide.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "node scripts/paraglide.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node scripts/test.mjs run",
    "test:watch": "node scripts/test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "icon": "node scripts/app-icon.mjs",
    "symbols": "node scripts/symbol-table.mjs",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.49.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror": "^6.0.2",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  }
}
